# Public URL of this admin app
NEXT_PUBLIC_BASE_URL=https://admin.example.com
AUTH_URL=https://admin.example.com

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Same PostgreSQL database as the public WinPeak site
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/winpeak?sslmode=require

# Staff sign-in (set a strong unique password in the host env)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public player site origin, used in affiliate tracking links
WINPEAK_SITE_URL=https://www.example.com

# Optional: absolute path to the public site project root so blog uploads land in its /public folder
# WINPEAK_PUBLIC_ROOT=/var/www/winpeak
